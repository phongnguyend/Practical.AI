<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the application does, expressed only as contracts over the domain: the store and pipeline
    abstractions the outer layers implement, the settings those implementations are configured from, and
    the orchestration that needs nothing more than the abstractions. Like the domain it carries no package
    references, so an implementation choice cannot be made here by accident.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharePointToAzureSearch.Domain\SharePointToAzureSearch.Domain.csproj" />
  </ItemGroup>

</Project>
