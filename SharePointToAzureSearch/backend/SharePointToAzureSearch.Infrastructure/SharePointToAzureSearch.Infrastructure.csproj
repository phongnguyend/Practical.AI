<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the application talks to from outside the process: Microsoft Graph and SharePoint, Azure AI
    Search, Azure OpenAI and the chat agent, Service Bus, Blob Storage, Document Intelligence, MarkItDown,
    and the officecli MCP server. It also holds the composition root the executable hosts call into.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharePointToAzureSearch.Application\SharePointToAzureSearch.Application.csproj" />
    <ProjectReference Include="..\SharePointToAzureSearch.Persistence\SharePointToAzureSearch.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageReference Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.20.0" />
    <PackageReference Include="Microsoft.Graph" Version="6.5.0" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

</Project>
