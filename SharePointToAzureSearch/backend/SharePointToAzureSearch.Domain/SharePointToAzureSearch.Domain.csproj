<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The innermost layer: the records, enums, and exceptions the application is written in terms of, plus
    the pure helpers over them. It deliberately has no package references, so nothing about SharePoint,
    Azure AI Search, SQL Server, or HTTP can leak into the vocabulary the other layers share.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
