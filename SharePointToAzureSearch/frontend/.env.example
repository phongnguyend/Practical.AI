# Where `npm run dev` proxies /api. Defaults to the API's http launch profile.
VITE_API_PROXY_TARGET=http://localhost:5263

# Only for a build served from a different origin than the API. Leave empty to use same-origin /api,
# which is what the dev proxy provides. When set, the API must list this app's origin in Cors:AllowedOrigins.
# VITE_API_BASE_URL=https://my-api.example.com
